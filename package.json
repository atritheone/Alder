{
  "name": "alder",
  "version": "0.11.0",
  "private": true,
  "description": "Alder Organic Language Engine for Windows",
  "homepage": "https://atritheone.com/alder",
  "alderSetup": {
    "dataCompatibility": 1,
    "descriptions": {
      "win32": "Alder Organic Language Engine for Windows",
      "linux": "Alder Organic Language Engine for Linux",
      "darwin": "Alder Organic Language Engine for Mac"
    }
  },
  "main": "dist-electron/main.cjs",
  "author": {
    "name": "Alder",
    "email": "edward@atritheone.com"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "test": "vitest run",
    "package": "npm run build && node scripts/prepare-javascript-notices.mjs && node scripts/package-desktop.mjs",
    "format": "prettier --write frontend electron scripts/*.mjs *.json *.ts",
    "branding": "electron scripts/prepare-branding.cjs",
    "installer": "npm run package && node scripts/build-installer.mjs",
    "package:linux": "npm run package -- --linux",
    "package:mac": "npm run package -- --mac"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "6.3.289",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.7",
    "prosemirror-model": "^1.24.0",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.2",
    "prosemirror-view": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "3.8.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "org.alder.language",
    "productName": "Alder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "**/*.json",
          "**/*.ttf",
          "!tests/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "work/bundle-resources",
        "to": ".",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "LICENCE.md",
        "to": "LICENCE.md"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/alder.ico",
      "signExecutable": false
    },
    "copyright": "Copyright (c) 6AE slayer",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "icon": "build/alder.icns"
    },
    "linux": {
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icons",
      "maintainer": "Alder <edward@atritheone.com>",
      "executableName": "alder",
      "desktop": {
        "entry": {
          "MimeType": "application/x-alder;"
        }
      }
    },
    "fileAssociations": [
      {
        "ext": "alder",
        "name": "Alder project",
        "mimeType": "application/x-alder",
        "role": "Editor"
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.3.0": true
  },
  "license": "MIT"
}
