{
  "name": "alder",
  "version": "0.1.0",
  "private": true,
  "description": "Alder - an organic language engine",
  "main": "dist-electron/main.cjs",
  "author": "Alder",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "desktop": "electron .",
    "test": "vitest run",
    "package": "npm run build && node scripts/prepare-javascript-notices.mjs && node scripts/verify-resources.mjs && electron-builder --win --dir",
    "format": "prettier --write frontend electron scripts/*.mjs *.json *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.3.289",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.24.0",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.2",
    "prosemirror-view": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "3.8.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "org.alder.language",
    "productName": "Alder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "work/bundle-resources",
        "to": ".",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "LICENCE.md",
        "to": "LICENCE.md"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "copyright": "Copyright (c) 6AE slayer"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true,
    "electron@44.3.0": true
  },
  "license": "MIT"
}
